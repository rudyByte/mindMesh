{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "web/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}
